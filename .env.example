# ── DART 오픈API (사업자등록번호 조회) ─────────────────────────────
# https://opendart.fss.or.kr 에서 무료 발급 (일 20,000건)
DART_API_KEY=

# ── SMTP (메일 발송) ───────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@example.com
SMTP_PASSWORD=your-app-password
# SSL(465) 을 쓰면 SMTP_USE_SSL=true / SMTP_USE_STARTTLS=false 로 두세요.
SMTP_USE_SSL=false
SMTP_USE_STARTTLS=true

# ── 수신자 ─────────────────────────────────────────────────────────
MAIL_FROM=your-account@example.com
MAIL_TO=wonjiyun@hanafn.com
MAIL_CC=

# ── 선택 옵션 ──────────────────────────────────────────────────────
# 빈 값=전체, stockMkt=유가증권, kosdaqMkt=코스닥, konexMkt=코넥스
KIND_MARKET=
OUT_DIR=out
CACHE_DIR=.cache
REQUEST_TIMEOUT=30

# ── 예약 매크로 (booking_macro) ────────────────────────────────────
# 시나리오에서 {{ env.* }} 로 참조할 수 있는 이름은 BOOKING_ / RESERVE_ 로
# 시작하는 것만 허용됩니다(시나리오가 다른 비밀값을 읽어 가지 못하도록).
BOOKING_USER=
BOOKING_PASSWORD=

# 브라우저 창을 보려면 false (기본 true = 창 없이 실행)
BOOKING_HEADLESS=true
BOOKING_BROWSER=chromium
# 확정 단계(commit)를 누르지 않고 직전까지만: true
BOOKING_DRY_RUN=false
# 화면 저장 always / change(성공·실패 시) / never
BOOKING_SCREENSHOT=change
BOOKING_OUT_DIR=out/booking
# 로그인 쿠키를 저장해 다음 실행에서 재사용 (예: .cache/booking-state.json)
BOOKING_STATE_FILE=
# 페이지 이동을 어디까지 기다릴지. 기본 domcontentloaded.
# 공공기관 사이트는 화면이 다 그려진 뒤에도 추적 스크립트가 남아 load 가 끝나지
# 않는 일이 잦습니다. 그래도 안 되면 commit 으로 낮춰 보세요.
BOOKING_WAIT_UNTIL=domcontentloaded
# --probe 가 화면을 여는 데 쓸 시간(밀리초). 느린 사이트면 늘리세요.
BOOKING_PROBE_TIMEOUT_MS=60000
