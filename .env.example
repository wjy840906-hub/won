# ── DART 오픈API (사업자등록번호 조회) ─────────────────────────────
# https://opendart.fss.or.kr 에서 무료 발급 (일 20,000건)
DART_API_KEY=

# ── SMTP (메일 발송) ───────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@example.com
SMTP_PASSWORD=your-app-password
# SSL(465) 을 쓰면 SMTP_USE_SSL=true / SMTP_USE_STARTTLS=false 로 두세요.
SMTP_USE_SSL=false
SMTP_USE_STARTTLS=true

# ── 수신자 ─────────────────────────────────────────────────────────
MAIL_FROM=your-account@example.com
MAIL_TO=wonjiyun@hanafn.com
MAIL_CC=

# ── 선택 옵션 ──────────────────────────────────────────────────────
# 빈 값=전체, stockMkt=유가증권, kosdaqMkt=코스닥, konexMkt=코넥스
KIND_MARKET=
OUT_DIR=out
CACHE_DIR=.cache
REQUEST_TIMEOUT=30

# ── 신고 거래량 선별 (python -m volume_peak) ───────────────────────
# 기준일(비우면 최근 영업일), 비교 기간(년)
TRADE_DATE=
VOLUME_YEARS=10
# 빈 값/ALL=전체, STK=유가증권, KSQ=코스닥, KNX=코넥스
KRX_MARKET=ALL
# 기준일 거래량·거래대금 하한(조회 건수를 줄이고 잡음을 걸러낸다)
MIN_VOLUME=100000
MIN_VALUE=1000000000
# 최소 거래일 수(이보다 짧은 신규상장은 제외)
MIN_HISTORY_DAYS=250
# 상위 N종목만(0=전체), 정렬 기준: value/ratio/volume
TOP_N=0
SORT_BY=value
# 개별종목 시세 동시 조회 수
KRX_WORKERS=8
