# ── DART 오픈API (사업자등록번호 조회) ─────────────────────────────
# https://opendart.fss.or.kr 에서 무료 발급 (일 20,000건)
DART_API_KEY=

# ── SMTP (메일 발송) ───────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@example.com
SMTP_PASSWORD=your-app-password
# SSL(465) 을 쓰면 SMTP_USE_SSL=true / SMTP_USE_STARTTLS=false 로 두세요.
SMTP_USE_SSL=false
SMTP_USE_STARTTLS=true

# ── 수신자 ─────────────────────────────────────────────────────────
MAIL_FROM=your-account@example.com
MAIL_TO=wonjiyun@hanafn.com
MAIL_CC=

# ── 선택 옵션 ──────────────────────────────────────────────────────
# 빈 값=전체, stockMkt=유가증권, kosdaqMkt=코스닥, konexMkt=코넥스
KIND_MARKET=
OUT_DIR=out
CACHE_DIR=.cache
REQUEST_TIMEOUT=30

# ── 소설 매크로 (novel_writer) ─────────────────────────────────────
# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=
NOVEL_MODEL=claude-opus-5
# low / medium / high / xhigh / max — 높일수록 더 공들여 쓰고 비용도 오릅니다.
NOVEL_EFFORT=high
NOVEL_CHAPTERS=10
NOVEL_CHAPTER_CHARS=3000
NOVEL_OUT_DIR=out/novel
